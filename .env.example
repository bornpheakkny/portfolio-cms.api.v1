# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed frontends (portfolio + cms)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Neon Postgres ----
# Pooled connection (host contains "-pooler") — used by the app at runtime
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Direct connection — used by prisma migrate
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ---- Auth (generate with: openssl rand -base64 48) ----
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
# Admin account created by `pnpm db:seed`
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-strong-password

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=portfolio

# ---- Portfolio on-demand revalidation (Next.js on Vercel) ----
PORTFOLIO_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-shared-with-portfolio
